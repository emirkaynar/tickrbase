# Local setup: copy this file to backend/.env.dev (ignored by Git).
# Select non-local environments using the process ENV, not this file.
DATABASE_URL=postgresql+asyncpg://tickrbase:tickrbasepass@localhost:5432/tickrbase
REDIS_URL=redis://localhost:6379/0
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional; supply your own provider token locally. Never commit credentials.
LOGO_DEV_TOKEN=
LOGO_DEV_MONTHLY_LIMIT=500000
